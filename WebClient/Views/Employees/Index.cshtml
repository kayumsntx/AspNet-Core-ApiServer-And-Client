@model IEnumerable<Employee>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Employee List</h2>
    <a asp-action="Create" class="btn btn-primary mb-2 mt-2">Create New Employee</a>


</div>
<table class="table table-bordered table-striped">
    <thead>
        <tr>

            <th>
                Image
            </th>
            <th>Name</th>
            <th>Join Date</th>
            <th>Active?</th>
            <th>Experiences</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {

            <tr>
                <td><img src="http://localhost:5280/images/@item.ImageName" width="60" height="60" style="object-fit:cover;" /></td>
                <td>@item.EmployeeName</td>
                <td>@item.JoinDate.ToShortDateString()</td>
                <td>@(item.IsActive ? "Yes" : "No")</td>
                <td>
                    @foreach (var exp in item.Experiences)
                    {
                        <span class="badge bg-info text-dark">
                            @exp.ExperienceTitle?.TitleName (@exp.Duration)
                        </span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.EmployeeId" class="btn btn-sm btn-warning">Edit</a>

                    <a asp-action="Delete" asp-route-id="@item.EmployeeId" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>